# Postgres
POSTGRES_HOST=localhost
POSTGRES_USER=dmean
POSTGRES_PASSWORD=dmean
POSTGRES_DB=dmean
POSTGRES_PORT=5432
# App login roles (created by db/roles.sql)
API_DB_PASSWORD=api
ORCHESTRATOR_DB_PASSWORD=orchestrator
WORKER_DB_PASSWORD=worker

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (S3-compatible; swap S3_ENDPOINT for LocalStack/AWS)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dmean
S3_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# API
API_PORT=3000
UPLOAD_TTL_HOURS=24
MAX_UPLOAD_FILE_BYTES=33554432

# Worker
TASK_TIME_LIMIT_SECS=250
JOB_CHECK_SECS=3
HEARTBEAT_TTL_SECS=30
HEARTBEAT_EVERY_SECS=10
