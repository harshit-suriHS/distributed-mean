# Postgres
POSTGRES_HOST=localhost
POSTGRES_USER=dmean
POSTGRES_PASSWORD=dmean
POSTGRES_DB=dmean
POSTGRES_PORT=5432
# App login roles (created by db/roles.sql)
API_DB_PASSWORD=api
ORCHESTRATOR_DB_PASSWORD=orchestrator

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (S3-compatible; swap S3_ENDPOINT for LocalStack/AWS)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dmean
S3_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# API
API_PORT=3000
UPLOAD_TTL_HOURS=24
MAX_UPLOAD_FILE_BYTES=33554432

# Worker
WORKERS=3                      # docker compose worker replicas
ORCHESTRATOR_ADDR=localhost:50051
LEASE_WAIT_SECS=20
# Local demos of heterogeneous speed: extra seconds per input file
SLOWDOWN_SECS_PER_FILE=0

# Orchestrator (defaults are production values; see design.md §7, §9)
GRPC_PORT=50051
